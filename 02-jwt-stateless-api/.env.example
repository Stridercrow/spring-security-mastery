# PostgreSQL
POSTGRES_DB=securitydb
POSTGRES_USER=security
POSTGRES_PASSWORD=security
POSTGRES_PORT=5432

# Spring Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/securitydb
SPRING_DATASOURCE_USERNAME=security
SPRING_DATASOURCE_PASSWORD=security

# JWT (change this to a long random secret in production)
SECURITY_JWT_SECRET=change-me-to-a-long-development-secret-at-least-32-chars

# JWT expiration in seconds (default: 900 = 15 minutes)
SECURITY_JWT_EXPIRATION_SECONDS=900
